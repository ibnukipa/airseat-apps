<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.redesign.bookstoreai.audiobookplayer">

    <!-- Internet permission for streaming audio -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Network state permission for checking connectivity -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Wake lock permission for background playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Foreground service permission for background playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Media session permission -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <application>
        <!-- Media session service for background playback -->
        <service
            android:name=".AudiobookPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>